# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env` — only `.env.example` (with placeholders) belongs in the repo.

# --- Application ---
APP_ENV=development
APP_NAME=JARVIS
LOG_LEVEL=INFO

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://jarvis:jarvis@localhost:5432/jarvis

# --- LLM provider ---
# Provider identifier for the LLMProvider abstraction (e.g. "ollama").
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# --- Voice: wake word ---
WAKE_WORD_ENABLED=true
WAKE_WORD_PROVIDER=openwakeword
# Path to a downloaded openWakeWord ONNX model, e.g. .\models\wakeword\hey_jarvis_v0.1.onnx
# See docs/voice-system.md for how to download it. No real path is provided here.
WAKE_WORD_MODEL_PATH=
WAKE_WORD_THRESHOLD=0.5

# --- Voice: audio I/O ---
# Empty = system default device. Set to a sounddevice device index/name to override.
MICROPHONE_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_LISTEN_SECONDS=5.0

# --- Voice: speech-to-text (Faster-Whisper) ---
STT_PROVIDER=faster_whisper
# Model size: tiny | base | small | medium | large-v3 (bigger = more accurate, slower, more RAM)
STT_MODEL=base
STT_LANGUAGE=en
STT_DEVICE=cpu

# --- Voice: text-to-speech (Piper) ---
TTS_PROVIDER=piper
# Path to a downloaded Piper voice model, e.g. .\models\tts\en_US-lessac-medium.onnx
# See docs/voice-system.md for how to download it. No real path is provided here.
TTS_MODEL_PATH=
TTS_VOICE=en_US-lessac-medium

# --- Future integration credentials (placeholders only, unused in Phase 0) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Conversation (Phase 3; in-memory only, never persisted) ---
# Inactivity (seconds) after which the conversation context is dropped.
JARVIS_CONVERSATION_TIMEOUT_SECONDS=120
# Max recent user/assistant messages sent to the LLM as context (min 2).
JARVIS_MAX_CONVERSATION_MESSAGES=20

# --- Agent brain (Phase 4; classifies and plans, never executes) ---
# false = plain LLM answers, no intent classification/planning.
JARVIS_AGENT_ENABLED=true
JARVIS_AGENT_MAX_PLAN_STEPS=8

# --- Personal memory (Phase 6; local PostgreSQL; run `alembic -c database/alembic.ini upgrade head` once) ---
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_MAX_RETRIEVAL=5
# false = never auto-save; every candidate waits for confirmation.
JARVIS_MEMORY_AUTO_SAVE=true
# low | medium | high: candidates below this are never auto-saved.
JARVIS_MEMORY_MIN_CONFIDENCE=medium

# --- Personal RAG (Phase 7; local documents; run `alembic -c database/alembic.ini upgrade head` once) ---
JARVIS_RAG_ENABLED=true
# Local SentenceTransformers model (downloaded once on first use, then offline).
JARVIS_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
JARVIS_RAG_TOP_K=5
JARVIS_RAG_CHUNK_SIZE=800
JARVIS_RAG_CHUNK_OVERLAP=100
# Cosine similarity threshold; below it JARVIS says it found nothing relevant.
JARVIS_RAG_MIN_SCORE=0.35
JARVIS_RAG_MAX_DOCUMENT_SIZE_MB=25
JARVIS_RAG_MAX_CHUNKS_PER_DOCUMENT=2000

# --- Personal knowledge graph (Phase 8; run `alembic -c database/alembic.ini upgrade head` once) ---
JARVIS_KG_ENABLED=true
JARVIS_KG_MAX_PATH_DEPTH=3
JARVIS_KG_MAX_RESULTS=20
# low | medium | high: below this, facts are not stored (extraction) or shown to the LLM.
JARVIS_KG_MIN_CONFIDENCE=medium

# --- Tasks and reminders (Phase 9; run `alembic -c database/alembic.ini upgrade head` once) ---
JARVIS_TASKS_ENABLED=true
JARVIS_REMINDERS_ENABLED=true
# IANA timezone name used to parse and show times, e.g. Asia/Kolkata or Europe/London.
# Empty = detect this computer's timezone once at startup (logged). The database always stores UTC.
JARVIS_TIMEZONE=
# How often the scheduler looks for due reminders (seconds, 1-3600).
JARVIS_REMINDER_POLL_SECONDS=15
# A reminder that came due while JARVIS was not running: notify (deliver late, marked as missed) | expire (do not deliver).
JARVIS_MISSED_REMINDER_POLICY=notify
# low | medium | high | critical
JARVIS_DEFAULT_TASK_PRIORITY=medium
# Where reminders are announced: a Windows tray notification and/or spoken by the voice engine.
JARVIS_REMINDER_DESKTOP_NOTIFICATIONS=true
JARVIS_REMINDER_VOICE_NOTIFICATIONS=true

# --- Gmail intelligence (Phase 10; read-only; see docs/gmail-intelligence.md for the Google Cloud setup) ---
JARVIS_GMAIL_ENABLED=false
# The client id/secret (lines near the top of this file) can be used INSTEAD of the credentials JSON below.
# OAuth "Desktop app" client JSON downloaded from Google Cloud, and the token written by `python scripts/gmail_cli.py auth`.
# Relative to the project folder; both are git-ignored. Never paste these into chat or commit them.
JARVIS_GMAIL_CREDENTIALS_PATH=.jarvis/gmail/credentials.json
JARVIS_GMAIL_TOKEN_PATH=.jarvis/gmail/token.json
# Most emails fetched per search (1-50).
JARVIS_GMAIL_MAX_RESULTS=10

# --- Google Calendar (Phase 12; see docs/google-calendar-integration.md for the Google Cloud setup) ---
JARVIS_CALENDAR_ENABLED=false
# OAuth "Desktop app" client. Either the JSON file below, or CALENDAR_CLIENT_ID/CALENDAR_CLIENT_SECRET
# (if those are empty, GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET are used). Never paste these into chat or commit them.
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
JARVIS_CALENDAR_CREDENTIALS_PATH=.jarvis/calendar/credentials.json
JARVIS_CALENDAR_TOKEN_PATH=.jarvis/calendar/token.json
# Most events read per calendar per request (1-100).
JARVIS_CALENDAR_MAX_RESULTS=20

# --- Event & deadline intelligence (Phase 11; run `alembic -c database/alembic.ini upgrade head` once) ---
JARVIS_EVENTS_ENABLED=true
# How many days ahead "what's coming up" looks (1-365).
JARVIS_EVENT_DEFAULT_LOOKAHEAD_DAYS=7
# Most events listed or searched at once (1-100).
JARVIS_EVENT_MAX_RESULTS=20

# --- Permissions (Phase 5; unknown tools are always denied, that is not configurable) ---
# Seconds a permission request stays valid before it expires.
JARVIS_PERMISSION_DEFAULT_EXPIRY_SECONDS=300
# Record security events (in memory plus SECURITY_EVENT log lines).
JARVIS_PERMISSION_AUDIT_ENABLED=true

# --- Windows runtime (Phase 2) ---
# false = `python -m desktop.launcher` exits immediately (e.g. to disable a startup-launched JARVIS).
JARVIS_RUNTIME_ENABLED=true
# false = run without a tray icon (headless; stop with Ctrl+C).
JARVIS_TRAY_ENABLED=true
